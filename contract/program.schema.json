{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.app/schema/program-1.0.json",
  "title": "LogicLens parsed program (POST /api/analyze/parse response)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "platform", "rungs", "warnings", "engine"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "enum": ["image", "text"] },
    "platform": {
      "enum": ["rockwell_logix", "rockwell_slc", "siemens_tia", "schneider", "mitsubishi", "omron", "abb", "generic_iec", "unknown"]
    },
    "platform_confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "rungs": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "text"],
        "properties": {
          "number": { "type": "integer", "minimum": 0 },
          "comment": { "type": ["string", "null"], "maxLength": 2000 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "bbox": { "$ref": "#/$defs/bboxOrNull" },
          "elements": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "mnemonic"],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "mnemonic": { "type": "string", "maxLength": 8 },
                "operands": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 120 } },
                "bbox": { "$ref": "#/$defs/bboxOrNull" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    },
    "detections": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "class_name", "confidence", "bbox"],
        "properties": {
          "class_id": { "type": "integer", "minimum": 0, "maximum": 43 },
          "class_name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "image": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overall": { "type": "number", "minimum": 0, "maximum": 100 },
            "blur": { "type": "number", "minimum": 0, "maximum": 100 },
            "contrast": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 500 } },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["yolo-onnx", "claude-vision", "hybrid", "text", "stub"] },
        "version": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "bboxOrNull": {
      "oneOf": [ { "$ref": "#/$defs/bbox" }, { "type": "null" } ]
    }
  }
}
